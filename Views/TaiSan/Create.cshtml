@model TranVanKiet_2026_1.Models.TaiSan
@{
    ViewData["Title"] = "Thêm tài sản mới";
}

<div class="section-head">
    <h3>THÊM TÀI SẢN MỚI</h3>
    <a asp-controller="TaiSan" asp-action="Index">&lsaquo; Quay lại danh sách</a>
</div>

<div style="background:#fff;padding:24px;border-radius:8px;max-width:560px;margin:20px auto;box-shadow:0 2px 6px rgba(0,0,0,0.08);">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:red;margin-bottom:10px;"></div>

        <div style="margin-bottom:14px;">
            <label asp-for="MaLoai" style="display:block;font-weight:bold;margin-bottom:6px;">Loại tài sản</label>
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;"></select>
            <span asp-validation-for="MaLoai" style="color:red;font-size:13px;display:block;margin-top:4px;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="TenTs" style="display:block;font-weight:bold;margin-bottom:6px;">Tên tài sản</label>
            <input asp-for="TenTs" type="text" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;" />
            <span asp-validation-for="TenTs" style="color:red;font-size:13px;display:block;margin-top:4px;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="NguyenGia" style="display:block;font-weight:bold;margin-bottom:6px;">Nguyên giá (triệu)</label>
            <input asp-for="NguyenGia" type="text" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;" />
            <span asp-validation-for="NguyenGia" style="color:red;font-size:13px;display:block;margin-top:4px;"></span>
        </div>

        <div style="margin-bottom:18px;">
            <label asp-for="Anh" style="display:block;font-weight:bold;margin-bottom:6px;">Tên file ảnh</label>
            <input asp-for="Anh" type="text" placeholder="vd: Img_1.jpg" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;" />
            <span asp-validation-for="Anh" style="color:red;font-size:13px;display:block;margin-top:4px;"></span>
        </div>

        <button type="submit" style="padding:10px 20px;background:#1d3f72;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">Create</button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}